{
    "name": "spatie/laravel-fast-paginate",
    "description": "A fast limit/offset paginator for Laravel",
    "keywords": [
        "Spatie",
        "laravel",
        "laravel-fast-paginate",
        "pagination",
        "deferred join"
    ],
    "homepage": "https://github.com/spatie/laravel-fast-paginate",
    "license": "MIT",
    "authors": [
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "laravel/scout": "^11.0",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "laravel/scout": "Required to use fastPaginate on Scout search builders (^11.0)."
    },
    "autoload": {
        "psr-4": {
            "Spatie\\FastPaginate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spatie\\FastPaginate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spatie\\FastPaginate\\FastPaginateServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
